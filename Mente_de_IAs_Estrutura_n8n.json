    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message || $json.body.chatInput || $json.message || $json.chatInput || '' }}",
        "options": {
          "maxIterations": 6,
          "systemMessage": "Você é o Orbit, um agente pessoal de alta qualidade. Responda sempre em português do Brasil, com Markdown limpo (títulos curtos, listas, blocos de código com linguagem).\n\nRegras:\n- Perguntas simples, explicações e conversa: responda diretamente, sem ferramentas.\n- Google Docs, Drive ou Gmail: delegue a 'agente_workspace_docs' passando a tarefa completa e autocontida.\n- Código, scripts, refatoração ou issues no GitHub: delegue a 'agente_dev_codigo'.\n- Nunca invente resultados de ferramentas. Se uma ferramenta falhar ou faltar credencial, diga isso claramente.\n- Antes de ações irreversíveis (enviar e-mail, criar/alterar arquivos), confirme com o usuário, salvo se o pedido já for explícito.\n- Seja direto: sem preâmbulos, sem repetir a pergunta."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        4896,
        1616
      ],
      "id": "991b890e-b636-48f5-88cc-588b606e1daa",
      "name": "AI Agent (Orquestrador)",
      "onError": "continueErrorOutput"
    },
