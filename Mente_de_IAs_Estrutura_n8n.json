    {
      "parameters": {
        "toolDescription": "Utilize esta ferramenta quando o usuário solicitar criar, ler, buscar ou editar arquivos no Google Docs, ler/enviar e-mails no Gmail ou manipular arquivos no Google Drive.",
        "text": "={{ $fromAI('tarefa', 'Descrição completa e autocontida da tarefa, com todos os dados necessários', 'string') }}",
        "options": {
          "maxIterations": 5,
          "systemMessage": "Você executa tarefas no Google Docs, Drive e Gmail. Use apenas as ferramentas disponíveis. Ao listar e-mails, resuma (remetente, assunto, data). Retorne um resultado curto em português e informe qualquer falha de ferramenta literalmente."
